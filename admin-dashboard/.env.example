# Base URL of the API (no trailing slash). Defaults to http://localhost:8080/api
VITE_API_URL=http://localhost:8080/api

# Cloudflare Turnstile SITE key (public). The admin API needs an access token, which needs a Turnstile solve.
# Add admin.yourdomain.com to the widget's hostnames in the Cloudflare dashboard.
VITE_TURNSTILE_SITE_KEY=
