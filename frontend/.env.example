# Base URL of the API (no trailing slash). Defaults to http://localhost:8080/api
VITE_API_URL=http://localhost:8080/api

# Cloudflare Turnstile SITE key (public). Needed to get emails and direct profile links.
# Local testing: 1x00000000000000000000AA always passes. 3x00000000000000000000FF always shows a challenge.
VITE_TURNSTILE_SITE_KEY=

# Contact form (https://web3forms.com): free access key, safe to expose in the browser.
VITE_WEB3FORMS_ACCESS_KEY=
