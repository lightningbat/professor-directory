PORT=8080
# SQLite file (created automatically). Use :memory: for throwaway runs.
DATABASE_PATH=./data/professors.db

# Frontend origin(s): used for CORS (comma-separated) and for redirecting after login.
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Fill an empty database with fake professors on startup (default: true outside production).
AUTO_SEED=true
SEED_COUNT=200

# --- Auth ---
# Required. Generate with:  openssl rand -base64 48
ACCESS_TOKEN_SECRET=
# Access token (stateless, needs a Turnstile solve to get): 10-15 minutes.
ACCESS_TOKEN_TTL_SECONDS=720
# Login token (stateful, httpOnly cookie): logged out after this many idle days, or this many days in total.
AUTH_TOKEN_IDLE_DAYS=14
AUTH_TOKEN_TTL_DAYS=30

# Cloudflare Turnstile secret key (dashboard.cloudflare.com -> Turnstile -> your widget). REQUIRED in production.
# Without it (development only) any Turnstile token is accepted. Add both mydomain.com and
# admin.mydomain.com to the widget's hostnames. For local testing Cloudflare publishes dummy keys, e.g. the
# always-pass secret 1x0000000000000000000000000000000AA (pair it with the site key 1x00000000000000000000AA).
TURNSTILE_SECRET_KEY=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application).
# Add GOOGLE_REDIRECT_URI as an "Authorized redirect URI". Without these the site still
# works for logged-out visitors, but login returns 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Cookies. Secure defaults to true in production (HTTPS only).
# COOKIE_SECURE=true
# lax works when frontend and API share a site; use none (requires Secure) for different sites.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# Behind a reverse proxy / load balancer, set the number of proxies in front of the app
# (e.g. 1) so the per-IP reveal limit sees the real client IP. Leave false otherwise.
TRUST_PROXY=false

# --- Admin dashboard ---
# Google accounts (comma-separated) allowed to open /api/admin. They log in with Google like anyone else.
ADMIN_EMAILS=
# Where the admin dashboard runs (CORS + post-login redirect).
ADMIN_URL=http://localhost:5174
# "Today" in the dashboard uses this timezone (IANA name, e.g. Asia/Kolkata, America/New_York).
ANALYTICS_TIMEZONE=UTC
# How long visit statistics are kept.
ANALYTICS_RETENTION_DAYS=90
